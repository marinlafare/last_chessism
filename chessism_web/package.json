{
  "name": "chessism-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 6789 --strictPort",
    "check:architecture": "node scripts/check-page-boundaries.mjs",
    "check:source-size": "node scripts/check-source-size.mjs",
    "test:matrices": "node --test tests/matrixForm.test.mjs",
    "test:algorithms": "node --test tests/algorithmForm.test.mjs",
    "test:algorithms:browser": "node scripts/test-algorithms-browser.mjs",
    "test:matrices:browser": "node scripts/test-matrix-browser.mjs",
    "test:live": "node --test tests/browserStockfish.test.mjs",
    "test:live:browser": "node scripts/test-live-analysis-browser.mjs",
    "test:live:layout": "node scripts/test-live-layout-browser.mjs",
    "test:ingestion": "node --test tests/statusPolling.test.mjs tests/gameJobPolling.test.mjs tests/automaticIngestion.test.mjs tests/pipelineProgress.test.mjs",
    "test:ingestion:browser": "node scripts/test-ingestion-browser.mjs",
    "test:progress": "node --test tests/statusPolling.test.mjs tests/gameJobPolling.test.mjs tests/cloudStatusPolling.test.mjs tests/positionsProgress.test.mjs tests/positionStatusFreshness.test.mjs tests/progressMeter.test.mjs tests/cloudJobProgress.test.mjs tests/pipelineProgress.test.mjs",
    "test:progress:browser": "node scripts/test-ingestion-browser.mjs && node scripts/test-cloud-step-progress-browser.mjs && node scripts/test-cloud-stop-browser.mjs",
    "test:player-summaries": "node --test tests/activityBalance.test.mjs",
    "test:player-summaries:browser": "node scripts/test-player-summaries-browser.mjs",
    "test:openings:browser": "node scripts/test-opening-sort-browser.mjs",
    "test:opponents:browser": "node scripts/test-opening-sort-browser.mjs opponents",
    "test:player-photo:browser": "node scripts/test-player-pinned-photo-browser.mjs",
    "build": "npm run check:architecture && npm run check:source-size && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 6789 --strictPort"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^18.2.0",
    "react-chessboard": "^4.7.3",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^5.4.0"
  }
}
