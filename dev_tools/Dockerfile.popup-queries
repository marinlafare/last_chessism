# Rebuild the previous API overlay plus popup fixes in ONE layer; the base
# already has 126 layers. Do not stack on the previous 127-layer runtime.
ARG BASE_IMAGE=chessism-api:fen-queue-separation-20261029
FROM scratch AS update
COPY chessism_api/operations/player_game_explorer.py chessism_api/operations/player_game_explorer_query.py chessism_api/operations/player_accuracy_distribution.py chessism_api/operations/player_blunder_page.py chessism_api/operations/player_score_distribution.py chessism_api/operations/player_score_position_page.py /app/chessism_api/operations/
COPY chessism_api/routers/players.py chessism_api/routers/jobs.py chessism_api/routers/cloud_analysis.py /app/chessism_api/routers/
COPY worker.py /app/worker.py
FROM ${BASE_IMAGE}
COPY --from=update /app/ /app/
