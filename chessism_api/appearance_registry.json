        "background",
        "borderColor",
        "borderWidth",
        "radius",
        "padding"
      ]
    },
    "chart.disclosure": {
      "label": "Rating groups disclosure",
      "properties": [
        "background",
        "color",
        "borderColor",
        "borderWidth",
        "radius",
        "padding",
        "fontSize",
        "fontFamily",
        "textAlign"
      ]
    },
    "explorer.panel": {
      "label": "Position explorer panel",
      "properties": [
        "background",
        "borderColor",
        "borderWidth",
        "radius",
        "padding"
      ]
    },
    "metric.scored_positions": {
      "label": "Metric: scored positions",
      "properties": [
        "background",
        "borderColor",
        "borderWidth",
        "radius",
        "padding"
      ]
    },
    "metric.unscored_positions": {
      "label": "Metric: unscored positions",
      "properties": [
        "background",
        "borderColor",
        "borderWidth",
        "radius",
        "padding"
      ]
    },
    "metric.games": {
      "label": "Metric: games",
      "properties": [
        "background",
        "borderColor",
        "borderWidth",
        "radius",
        "padding"
      ]
    },
    "metric.unscored_games": {
      "label": "Metric: unscored games",
      "properties": [
        "background",
        "borderColor",
        "borderWidth",
        "radius",
        "padding"
      ]
    },
    "slice.2": {
      "label": "2 appearances slice",
      "editorParent": "repeated.outline",
      "properties": [
        "fill"
      ]
    },
    "slice.3": {
      "label": "3 appearances slice",
      "editorParent": "repeated.outline",
      "properties": [
