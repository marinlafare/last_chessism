      ]
    },
    "metric.title": {
      "label": "Summary chart labels",
      "properties": [
        "color",
        "fontSize",
        "fontFamily",
        "textAlign"
      ]
    },
    "metric.value": {
      "label": "Summary chart numbers",
      "properties": [
        "color",
        "fontSize",
        "fontFamily",
        "textAlign"
      ]
    },
    "position.label": {
      "label": "position label",
      "properties": [
        "color",
        "fontSize",
        "fontFamily",
        "textAlign"
      ]
    },
    "position.count": {
      "label": "position count",
      "properties": [
        "color",
        "fontSize",
        "fontFamily",
        "textAlign"
      ]
    },
    "panel.title": {
      "label": "panel title",
      "properties": [
        "color",
        "fontSize",
        "fontFamily",
        "textAlign"
      ]
    }
  }
}
