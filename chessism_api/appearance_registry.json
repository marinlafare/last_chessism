{
  "version": 1,
  "scope": "scored_positions",
  "properties": {
    "background": {
      "label": "Background",
      "kind": "color",
      "css": "background-color"
    },
    "color": {
      "label": "Text color",
      "kind": "color",
      "css": "color"
    },
    "borderColor": {
      "label": "Border color",
      "kind": "color",
      "css": "border-color"
    },
    "borderWidth": {
      "label": "Border width",
      "kind": "number",
      "min": 0,
      "max": 8,
      "unit": "px",
      "css": "border-width"
    },
    "radius": {
      "label": "Corner radius",
      "kind": "number",
      "min": 0,
      "max": 40,
      "unit": "px",
      "css": "border-radius"
    },
    "padding": {
      "label": "Padding",
      "kind": "number",
      "min": 0,
      "max": 48,
      "unit": "px",
      "css": "padding"
    },
    "homeTopMargin": {
      "label": "Top margin (rem)",
      "kind": "number",
      "min": 0,
      "max": 12,
      "step": 0.25,
      "unit": "rem",
      "css": "--home-top-gap",
      "default": 3
    },
    "fontSize": {
      "label": "Font size",
      "kind": "number",
      "min": 10,
      "max": 40,
      "unit": "px",
      "css": "font-size"
    },
    "fontFamily": {
      "label": "Font",
      "kind": "choice",
      "options": [
        "Inter",
        "IBM Plex Mono",
        "system-ui"
      ],
      "css": "font-family"
    },
    "textAlign": {
      "label": "Text alignment",
      "kind": "choice",
      "options": [
        "left",
        "center",
        "right"
      ],
      "css": "text-align"
    },
    "fill": {
      "label": "Slice color",
      "kind": "color",
      "css": "fill"
    },
    "stroke": {
      "label": "Border color",
      "kind": "color",
      "css": "--pie-outline-color",
      "default": "#ffffff"
    },
    "strokeWidth": {
      "label": "Border width",
      "kind": "number",
      "min": 0,
      "max": 6,
      "unit": "px",
      "css": "--pie-outline-width",
      "default": 1.5
    },
    "hoverBackground": {
      "label": "Hover background",
      "kind": "color",
      "css": "background-color",
      "state": ":hover"
    },
    "hoverColor": {
      "label": "Hover text",
      "kind": "color",
      "css": "color",
      "state": ":hover"
    }
  },
  "targets": {
    "page": {
      "label": "Page background",
      "properties": [
        "background",
        "color",
        "fontFamily"
      ]
    },
    "metrics.panel": {
      "label": "Metrics panel",
      "properties": [
        "background",
        "borderColor",
        "borderWidth",
        "radius",
        "padding"
      ]
    },
    "appearances.panel": {
      "label": "FEN appearance panel",
      "properties": [
        "background",
        "borderColor",
        "borderWidth",
        "radius",
        "padding"
      ]
    },
    "appearance.tab": {
      "label": "Appearance tabs",
      "properties": [
        "background",
        "color",
        "borderColor",
        "borderWidth",
        "radius",
        "padding",
        "fontSize",
        "fontFamily",
        "textAlign",
        "hoverBackground",
        "hoverColor"
      ]
    },
    "position.button": {
      "label": "Position buttons",
      "properties": [
        "background",
        "borderColor",
        "borderWidth",
        "radius",
        "padding",
        "hoverBackground",
        "hoverColor"
      ]
    },
    "position.rank": {
      "label": "Position rank badges",
      "properties": [
        "background",
        "color",
        "borderColor",
        "borderWidth",
        "radius",
        "padding",
        "fontSize",
        "fontFamily",
        "textAlign"
      ]
    },
    "unique.outline": {
      "label": "Unique circle border",
      "properties": [
        "stroke",
        "strokeWidth"
      ]
    },
    "repeated.outline": {
      "label": "Less common circle border",
      "properties": [
        "stroke",
        "strokeWidth"
      ]
    },
    "coverage.outline": {
      "label": "Scored/unscored circle border",
      "properties": ["stroke", "strokeWidth"]
    },
    "coverage.scored": {
      "label": "Scored FEN slice",
      "editorParent": "coverage.outline",
      "properties": ["fill"]
    },
    "coverage.unscored": {
      "label": "Unscored FEN slice",
      "editorParent": "coverage.outline",
      "properties": ["fill"]
    },
    "unique.slice": {
      "label": "Unique slice",
      "editorParent": "unique.outline",
      "properties": [
        "fill"
      ]
    },
    "nonunique.slice": {
      "label": "Non-unique slice",
      "editorParent": "unique.outline",
      "properties": [
        "fill"
      ]
    },
    "circle.caption": {
      "label": "Circle captions",
      "properties": [
        "color",
        "fontSize",
        "fontFamily",
        "textAlign"
      ]
    },
    "cuda.panel": {
      "label": "Reserved CUDA panel",
      "properties": [
        "background",
        "borderColor",
        "borderWidth",
        "radius",
        "padding"
      ]
    },
    "backup.panel": {
